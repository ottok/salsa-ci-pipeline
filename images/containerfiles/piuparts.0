RUN apt-get update && apt-get upgrade -y && eatmydata apt-get install --no-install-recommends -y piuparts mmdebstrap apt-utils && rm -rf /var/lib/apt

COPY ./scripts/*_install_*_configs /etc/piuparts/scripts/

RUN chmod -c o-w /etc/piuparts/scripts/*_install_*_configs
